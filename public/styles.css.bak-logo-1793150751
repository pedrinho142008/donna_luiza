/* CART AND OVERLAYS */
.page-scrim { position: fixed; inset: 0; z-index: 49; background: rgba(0,0,0,.68); backdrop-filter: blur(3px); }
.page-scrim.visible { display: block; }
.cart-drawer {
  position: fixed; z-index: 50; top: 0; right: 0;
  width: min(440px,100%); height: 100dvh;
  display: flex; flex-direction: column;
  padding: 27px; background: #121110;
  border-left: 1px solid var(--line-copper);
  transform: translateX(105%); visibility: hidden;
  transition: transform .35s var(--ease), visibility .35s;
