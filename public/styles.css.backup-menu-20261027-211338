  }

  .hero h1 {
    font-size: 41px;
  }

  .hero-note {
    width: 135px;
    right: 16px;
  }

  .footer-main {
    grid-template-columns: minmax(0, 1fr);
  }

  .brand-footer {
    grid-column: 1;
  }
}

/* ==========================================
   DONNA LUIZA — IDENTIDADE PRAIANA REFINADA
   ========================================== */

:root {
  --deep: #174b4b;
  --orange: #d58b61;
  --sand: #f4eee2;
  --cream: #fffdf8;
  --gutter: clamp(16px, 4vw, 58px);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  max-width: 100%;
  overflow-x: clip;
  background: var(--cream);
}

img {
  display: block;
  max-width: 100%;
}

/* Cabeçalho mais leve e proporcional */
.site-header {
  min-height: 76px;
  padding: 10px clamp(16px, 4vw, 52px);
  gap: clamp(12px, 2vw, 26px);
  background: rgba(255, 253, 248, .97);
}

.site-header.scrolled {
  min-height: 68px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.brand-mark {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  object-fit: contain;
}

.brand-wording {
  min-width: 0;
}

.brand-name {
  line-height: 1.1;
}

.brand-subtitle {
  letter-spacing: .12em;
}

/* Menu de desktop: compacto, sem itens espremidos */
.main-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(12px, 1.7vw, 25px);
  min-width: 0;
}

.main-nav > a {
  font-size: 11px;
  line-height: 1.5;
  white-space: nowrap;
}

.main-nav > a:not(.nav-mobile-cta)::after {
  bottom: -5px;
}

/* Botões menores no site inteiro */
.button,
.nav-mobile-cta,
.dish-consult,
.filter-button,
.carousel-controls button,
button[type="submit"] {
  width: auto;
  max-width: 100%;
  min-height: 0;
  padding: 11px 18px;
  border-radius: 999px;
  font-size: 11px;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: .015em;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.hero-actions {
  gap: 14px;
}

.hero-actions .button {
  min-height: 43px;
  padding: 11px 18px;
}

.filter-button {
  padding: 9px 15px;
}

.dish-consult {
  padding: 9px 14px;
}

/* Hero: imagem protagonista, sem elementos exagerados */
.hero {
  min-height: clamp(560px, 72vh, 730px);
}

.hero-inner {
  padding-top: clamp(66px, 9vw, 110px);
}

.hero h1 {
  max-width: 690px;
  font-size: clamp(44px, 6.4vw, 78px);
  line-height: 1.04;
  text-wrap: balance;
}

.hero-copy > p {
  font-size: 14px;
  line-height: 1.8;
}

.hero-note {
  border-radius: 20px;
}

.hero-note p {
  font-size: 19px;
}

/* Seções com respiro e formas suaves */
.section-pad {
  padding: clamp(58px, 8vw, 104px) clamp(18px, 5vw, 74px);
}

.section-title {
  line-height: 1.12;
  text-wrap: balance;
}

.about-photo-frame {
  overflow: hidden;
  border-radius: 46% 46% 20px 20px;
}

.about-photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Cardápio: cards individuais, sem aparência de tabela */
.menu-section {
  background:
    radial-gradient(ellipse at 10% 5%, rgba(213, 139, 97, .08), transparent 34%),
    var(--sand);
}

.menu-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.filter-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-button {
  border: 1px solid rgba(23, 75, 75, .16);
  background: rgba(255, 253, 248, .8);
  color: var(--deep);
  transition: background .2s ease, color .2s ease;
}

.filter-button:hover,
.filter-button.active,
.filter-button[aria-pressed="true"] {
  background: var(--deep);
  color: white;
}

.menu-viewport {
  width: min(100%, 1320px);
  margin: 0 auto;
  overflow: visible;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-auto-flow: row;
  grid-auto-columns: auto;
  align-items: stretch;
  gap: clamp(16px, 2.2vw, 28px);
  padding: 8px 2px 18px;
  overflow: visible;
  scroll-snap-type: none;
}

.dish-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  border: 1px solid rgba(23, 75, 75, .09);
  border-radius: 22px;
  background: var(--cream);
  box-shadow: 0 7px 24px rgba(32, 62, 54, .055);
  transition: transform .25s ease, box-shadow .25s ease;
}

.dish-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 35px rgba(32, 62, 54, .11);
}

.dish-photo {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #e6dfd0;
}

.dish-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.dish-card:hover .dish-photo img {
  transform: scale(1.045);
}

.dish-category {
  left: 12px;
  top: 12px;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(255, 253, 248, .94);
  font-size: 9px;
  letter-spacing: .04em;
}

/* Estiliza a área de conteúdo sem depender de um nome específico */
.dish-card > div:not(.dish-photo) {
  min-width: 0;
}

.dish-card .dish-content,
.dish-card .dish-info,
.dish-card .dish-details {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 18px;
}

.dish-title,
.dish-card h3 {
  margin: 0;
  color: var(--deep);
  font-size: clamp(17px, 1.5vw, 21px);
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.dish-description,
.dish-card p {
  color: #69756d;
  font-size: 12px;
  line-height: 1.75;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  width: 100%;
  margin-top: auto;
}

.dish-card a,
.dish-card button {
  max-width: 100%;
  border-radius: 999px;
}

/* Galeria e reservas */
.experience-grid {
  gap: clamp(14px, 2vw, 24px);
}

.experience-card {
  overflow: hidden;
  border-radius: 24px;
}

.reservation-image-wrap {
  overflow: hidden;
  border-radius: 24px;
}

.reservation-content {
  min-width: 0;
}

.reservation-form {
  gap: 14px;
}

.reservation-form input,
.reservation-form select,
.reservation-form textarea,
.newsletter-form input {
  width: 100%;
  min-width: 0;
  border-radius: 13px;
}

.floating-whatsapp {
  right: 17px;
  bottom: 17px;
  width: 48px;
  height: 48px;
}

/* Tablet */
@media (max-width: 1080px) {
  .site-header {
    gap: 12px;
  }

  .main-nav {
    gap: 12px;
  }

  .main-nav > a {
    font-size: 10px;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Navegação móvel: menu vertical, confortável e sem sobreposição */
@media (max-width: 820px) {
  .site-header {
    min-height: 70px;
    padding: 9px 18px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
  }

  .menu-toggle {
    display: flex;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(23, 75, 75, .2);
    border-radius: 50%;
    background: transparent;
  }

  .main-nav {
    position: fixed;
    z-index: 61;
    inset: 70px 0 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0;
    margin: 0;
    padding: 18px 24px 35px;
    overflow-y: auto;
    background: rgba(255, 253, 248, .99);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity .22s ease, visibility .22s ease, transform .22s ease;
  }

  body.menu-open .main-nav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .main-nav > a {
    display: flex;
    align-items: center;
    min-height: 49px;
    padding: 12px 3px;
    border-bottom: 1px solid rgba(23, 75, 75, .09);
    color: var(--deep);
    font-size: 14px;
    white-space: normal;
  }

  .main-nav > a:not(.nav-mobile-cta)::after {
    display: none;
  }

  .main-nav > .nav-mobile-cta {
    align-self: flex-start;
    min-height: 42px;
    margin-top: 18px;
    padding: 12px 20px;
    border: 0;
    background: var(--deep);
    color: white;
  }

  body.menu-open {
    overflow: hidden;
  }

  .hero {
    min-height: 680px;
    min-height: min(760px, calc(100svh - 70px));
  }

  .hero-inner {
    padding: 65px 24px 185px;
  }

  .hero h1 {
    font-size: clamp(44px, 8vw, 66px);
  }

  .hero-note {
    right: 22px;
    bottom: 72px;
    width: 175px;
    min-height: 0;
    padding: 15px;
  }

  .hero-note p {
    font-size: 16px;
  }

  .hero-location {
    left: 22px;
    bottom: 23px;
  }
}

/* Celular */
@media (max-width: 600px) {
  .section-pad {
    padding: 58px 19px;
  }

  .hero {
    min-height: 690px;
    min-height: min(760px, calc(100svh - 70px));
  }

  .hero-inner {
    padding: 55px 20px 180px;
  }

  .hero h1 {
    max-width: 520px;
    margin-top: 20px;
    font-size: clamp(42px, 11.7vw, 58px);
    line-height: 1.06;
  }

  .hero-copy > p {
    max-width: 330px;
    font-size: 13px;
  }

  .hero-actions {
    align-items: flex-start;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-actions .button {
    min-height: 40px;
    padding: 10px 15px;
    font-size: 10px;
  }

  .hero-note {
    right: 20px;
    bottom: 77px;
    width: 145px;
    padding: 12px;
    border-radius: 16px;
  }

  .hero-note p {
    margin-bottom: 8px;
    font-size: 14px;
  }

  .hero-location {
    left: 20px;
    bottom: 22px;
  }

  .menu-toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 13px;
  }

  .filter-list {
    flex-wrap: nowrap;
    gap: 8px;
    max-width: 100%;
    overflow-x: auto;
    padding: 3px 1px 10px;
    scrollbar-width: none;
  }

  .filter-list::-webkit-scrollbar {
    display: none;
  }

  .filter-button {
    flex: 0 0 auto;
    padding: 9px 13px;
    font-size: 10px;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 0;
  }

  .dish-card {
    border-radius: 17px;
  }

  .dish-photo {
    aspect-ratio: 1 / 1;
  }

  .dish-category {
    top: 8px;
    left: 8px;
    padding: 5px 7px;
    font-size: 8px;
  }

  .dish-card .dish-content,
  .dish-card .dish-info,
  .dish-card .dish-details {
    gap: 8px;
    padding: 12px;
  }

  .dish-title,
  .dish-card h3 {
    font-size: 15px;
    line-height: 1.35;
  }

  .dish-description,
  .dish-card p {
    font-size: 11px;
    line-height: 1.6;
  }

  .dish-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 9px;
  }

  .dish-consult,
  .dish-card button,
  .dish-card a {
    padding: 9px 12px;
    font-size: 10px;
  }

  .experience-grid,
  .reservation,
  .visit-section {
    grid-template-columns: minmax(0, 1fr);
  }

  .experience-card {
    min-height: 300px;
    border-radius: 19px;
  }

  .reservation-image-wrap {
    min-height: 280px;
    border-radius: 20px;
  }

  .reservation-content {
    padding: 35px 20px;
  }

  .reservation-form {
    grid-template-columns: minmax(0, 1fr);
  }

  .reservation-form > * {
    min-width: 0;
    grid-column: 1 / -1;
  }

  .footer-main {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px 15px;
  }

  .footer-main > * {
    min-width: 0;
  }

  .brand-footer {
    grid-column: 1 / -1;
  }

  .newsletter-band {
    align-items: stretch;
    gap: 18px;
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .newsletter-form input {
    flex: 1 1 150px;
  }

  .newsletter-form button {
    flex: 0 0 auto;
  }
}

@media (max-width: 380px) {
  .brand-mark {
    width: 37px;
    height: 37px;
  }

  .brand-name {
    font-size: 18px;
  }

  .brand-subtitle {
    font-size: 7px;
  }

  .menu-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .dish-photo {
    aspect-ratio: 1.3 / 1;
  }

  .dish-card .dish-content,
  .dish-card .dish-info,
  .dish-card .dish-details {
    padding: 16px;
  }

  .dish-title,
  .dish-card h3 {
    font-size: 18px;
  }

  .dish-footer {
    align-items: center;
    flex-direction: row;
  }

  .footer-main {
    grid-template-columns: minmax(0, 1fr);
  }

  .brand-footer {
    grid-column: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
