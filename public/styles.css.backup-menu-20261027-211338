html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}

img {
  max-width: 100%;
}

.site-header {
  padding-left: clamp(16px, 4vw, 58px);
  padding-right: clamp(16px, 4vw, 58px);
  gap: 16px;
}

.brand {
  min-width: 0;
  flex-shrink: 0;
}

.brand-mark {
  width: clamp(42px, 5vw, 58px);
  height: clamp(42px, 5vw, 58px);
  object-fit: contain;
}

.button,
.filter-button,
