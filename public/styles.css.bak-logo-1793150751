}

/* ===== AJUSTE RESPONSIVO LIMPO ===== */

/* Impede que imagens comuns ocupem mais espaço do que deveriam. */
img, video, iframe {
  max-width: 100%;
}

.brand {
  display: inline-flex;
  align-items: center;
  flex: 0 1 auto;
  min-width: 0;
  gap: 0;
}

.site-header .brand-logo {
  display: block;
  width: 112px !important;
  max-width: 112px;
  height: auto;
  max-height: 38px;
  object-fit: contain;
  object-position: left center;
  flex: 0 0 auto;
}

.footer-brand .brand-logo {
  display: block;
  width: 145px !important;
  max-width: 100%;
  height: auto;
  max-height: 52px;
  object-fit: contain;
}

.site-header {
  gap: 12px;
}

.desktop-nav {
  min-width: 0;
  flex-wrap: nowrap;
}

.header-actions {
  flex: 0 0 auto;
  gap: 8px;
}

.button {
  max-width: 100%;
  white-space: normal;
  text-align: center;
  overflow-wrap: anywhere;
}

.section-shell,
.hero-copy,
.hero-visual,
.story-copy,
.story-collage,
.location-card,
.location-info,
.location-details {
  min-width: 0;
}

.menu-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.menu-card {
  min-width: 0;
  overflow: hidden;
}

.menu-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.menu-card h3,
.menu-card-description {
  overflow-wrap: anywhere;
}

/* Prévia de mapa em satélite. */
.location-map-preview {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
  border: 1px solid rgba(217,119,54,.22);
  border-radius: 18px;
  background: #171411;
}

.location-map-preview iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

.location-map-open {
  position: absolute;
  left: 12px;
  bottom: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  max-width: calc(100% - 24px);
  padding: 10px 15px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 999px;
  background: rgba(10,10,10,.94);
  color: #f5f0e8;
  font-size: 12px;
}

/* Tablet e telas menores: simplifica o cabeçalho. */
@media (max-width: 1050px) {
  .site-header {
    gap: 10px;
  }

  .desktop-nav {
    gap: 12px;
  }

  .desktop-nav a {
    font-size: 11px;
  }

  .site-header .brand-logo {
    width: 100px !important;
    max-width: 100px;
  }

  .header-actions {
    gap: 7px;
  }
}

/* Celulares: menu compacto, sem logo gigante nem colunas espremidas. */
@media (max-width: 760px) {
  .site-header {
    height: 68px;
    padding-left: 15px;
    padding-right: 15px;
    gap: 8px;
  }

  .site-header .brand-logo {
    width: 94px !important;
    max-width: 94px;
    max-height: 34px;
  }

  .header-actions {
    margin-left: auto;
    gap: 8px;
  }

  .icon-button {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
  }

  .section-shell {
    width: calc(100% - 32px);
  }

  .hero {
    width: calc(100% - 32px);
    max-width: 100%;
  }

  .hero h1 {
    font-size: clamp(36px, 9vw, 56px);
    overflow-wrap: normal;
  }

  .hero-visual {
    width: 100%;
    padding-right: 0;
  }

  .hero-image-wrap {
    width: 100%;
    max-width: 100%;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .menu-card-image {
    height: clamp(120px, 35vw, 190px);
  }

  .menu-card-body {
    padding: 12px;
  }

  .menu-card h3 {
    font-size: 16px;
  }

  .menu-card-description {
    min-height: 0;
  }

  .location-map-preview {
    height: 240px;
  }

  .footer-brand .brand-logo {
    width: 135px !important;
  }
}

/* Celulares estreitos. */
@media (max-width: 380px) {
  .site-header {
    padding-left: 11px;
    padding-right: 11px;
  }

  .site-header .brand-logo {
    width: 82px !important;
    max-width: 82px;
  }

  .header-actions {
    gap: 6px;
  }

  .icon-button {
    width: 37px;
    height: 37px;
    flex-basis: 37px;
  }

  .section-shell,
  .hero {
    width: calc(100% - 26px);
  }

  .menu-grid {
    gap: 8px;
  }

  .menu-card-body {
    padding: 9px;
  }

  .menu-card h3 {
    font-size: 14px;
  }

  .location-map-preview {
    height: 210px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

