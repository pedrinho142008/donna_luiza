:root {
  color-scheme: dark;
  --bg: #0a0a0a;
  --surface: #111110;
  --surface-2: #191817;
  --surface-3: #211e1b;
  --copper: #d97736;
  --copper-light: #ef9a5c;
  --ivory: #f5f0e8;
  --text: #f2eee8;
  --muted: #a49c93;
  --line: rgba(255,255,255,.10);
  --line-copper: rgba(217,119,54,.35);
  --font-display: "Playfair Display", Georgia, serif;
  --font-body: "DM Sans", Arial, sans-serif;
  --gutter: clamp(18px, 5.5vw, 88px);
  --content: 1440px;
  --radius: 22px;
  --radius-lg: 30px;
  --ease: cubic-bezier(.22,.68,0,1);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.65;
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
}
body.locked { overflow: hidden; }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { color: inherit; }
a { color: inherit; text-decoration: none; }
img, svg { display: block; max-width: 100%; }
img { width: 100%; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--copper-light);
  outline-offset: 4px;
}
::selection { color: #0a0a0a; background: var(--copper-light); }

.section-shell {
  width: min(100% - (var(--gutter) * 2), var(--content));
  margin-inline: auto;
}
.announcement {
  min-height: 31px;
  padding: 7px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #c9bcb0;
  background: #14110f;
  border-bottom: 1px solid rgba(217,119,54,.17);
  font-size: 9px;
  letter-spacing: .19em;
  text-align: center;
}
.announcement-dot, .status-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--copper);
  box-shadow: 0 0 10px rgba(217,119,54,.45);
}
.announcement-separator { color: var(--copper); }

.site-header {
  height: 88px;
  padding-inline: var(--gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(10,10,10,.91);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(255,255,255,.055);
}
.brand { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; }
.brand-symbol {
  width: 43px; height: 43px;
  display: grid; place-items: center;
  border: 1px solid var(--copper);
  border-radius: 50%;
  color: var(--copper-light);
  font-family: var(--font-display);
  font-size: 21px;
  letter-spacing: -.12em;
  padding-right: 4px;
}
.brand-symbol span { color: var(--ivory); }
.brand-copy { display: grid; line-height: 1.3; gap: 5px; }
.brand-copy strong { font-size: 12px; letter-spacing: .19em; font-weight: 600; }
.brand-copy small { color: var(--muted); font-size: 8px; letter-spacing: .15em; }
.desktop-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 44px); }
.desktop-nav a { color: #b9b2ab; font-size: 12px; transition: color .25s ease; }
.desktop-nav a:hover { color: var(--copper-light); }
.header-actions { display: flex; align-items: center; gap: 14px; }
.icon-button {
  position: relative;
  width: 42px; height: 42px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: transparent;
  display: grid; place-items: center;
  cursor: pointer;
  transition: border-color .25s, background .25s, transform .25s;
}
.icon-button:hover { border-color: var(--line-copper); background: #17120f; }
.icon-button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
.cart-count {
  position: absolute; top: -4px; right: -4px;
  min-width: 18px; height: 18px; padding-inline: 4px;
  display: grid; place-items: center;
  background: var(--copper); color: #140d08;
  font-size: 9px; font-weight: 700;
  border-radius: 20px; border: 2px solid var(--bg);
}
.button {
  min-height: 49px;
  display: inline-flex; align-items: center; justify-content: center;
  gap: 18px; padding: 13px 21px;
  border: 1px solid transparent; border-radius: 14px;
  cursor: pointer; font-size: 12px; font-weight: 600;
  text-align: center; line-height: 1.3;
  transition: transform .25s var(--ease), background .25s, border-color .25s, box-shadow .25s;
}
.button:hover { transform: translateY(-2px); }
.button-copper {
  color: #170e08;
  background: linear-gradient(130deg, #e99452, #d97736 68%, #bd6029);
  box-shadow: 0 8px 24px rgba(217,119,54,.12);
}
.button-copper:hover { box-shadow: 0 10px 32px rgba(217,119,54,.24); }
.button-outline { border-color: rgba(255,255,255,.21); color: var(--text); background: rgba(255,255,255,.015); }
.button-outline:hover { border-color: var(--copper); background: rgba(217,119,54,.06); }
.button-small { min-height: 41px; padding: 10px 16px; font-size: 11px; }
.button-arrow { font-size: 17px; font-weight: 400; }
.button-full { width: 100%; }
.mobile-menu-trigger { display: none; }
.mobile-menu, .page-scrim { display: none; }

/* HERO */
.hero {
  position: relative;
  min-height: min(720px, calc(100svh - 120px));
  display: grid;
  grid-template-columns: minmax(0, .96fr) minmax(0, 1.04fr);
  align-items: center;
  gap: clamp(30px, 5vw, 78px);
  padding-block: clamp(55px, 7vw, 100px) 80px;
}
.hero-copy { position: relative; z-index: 2; padding-block: 20px; }
.eyebrow {
  display: flex; align-items: center; gap: 11px;
  color: var(--copper-light); font-size: 9px;
  font-weight: 600; letter-spacing: .2em; line-height: 1.5;
}
.eyebrow-line { width: 25px; height: 1px; background: var(--copper); flex: 0 0 auto; }
h1, h2, h3, p, figure { margin-top: 0; }
.hero h1, .section-heading h2, .story-copy h2, .experience-heading h2,
.reservation-copy h2, .location-heading h2 {
  font-family: var(--font-display);
  font-weight: 400;
  letter-spacing: -.045em;
  line-height: 1.09;
}
.hero h1 {
  margin: 26px 0 22px;
  font-size: clamp(43px, 5.4vw, 78px);
}
h1 em, h2 em { color: var(--copper-light); font-weight: 400; }
.hero-description { max-width: 440px; color: var(--muted); font-size: 13px; line-height: 1.95; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.hero-trust { display: flex; align-items: center; gap: 20px; margin-top: 48px; }
.trust-item { display: flex; align-items: center; gap: 10px; }
.trust-icon { width: 35px; height: 35px; display: grid; place-items: center; border: 1px solid var(--line-copper); border-radius: 50%; color: var(--copper-light); font-size: 19px; }
.trust-item span:last-child { display: grid; gap: 2px; }
.trust-item strong { font-size: 10px; font-weight: 600; }
.trust-item small { color: var(--muted); font-size: 9px; }
.trust-divider { height: 30px; width: 1px; background: var(--line); }
.hero-visual { min-width: 0; position: relative; padding: 0 16px 12px 0; }
.hero-image-wrap {
  height: clamp(350px, 42vw, 570px);
  overflow: hidden; position: relative;
  border-radius: 48% 48% 22px 22px / 39% 39% 22px 22px;
  background: var(--surface-2);
  border: 1px solid rgba(217,119,54,.25);
  box-shadow: 0 30px 90px rgba(0,0,0,.45), 0 0 65px rgba(217,119,54,.055);
}
.hero-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hero-image-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(6,6,6,.83), transparent 48%), linear-gradient(90deg, rgba(10,10,10,.16), transparent 60%); pointer-events: none; }
.hero-image-label {
  position: absolute; bottom: 25px; left: 24px; right: 24px;
  display: flex; align-items: center; gap: 12px;
}
.label-mark {
  width: 42px; height: 42px; border: 1px solid var(--copper);
  border-radius: 50%; display: grid; place-items: center;
  color: var(--copper-light); font-family: var(--font-display); font-size: 17px;
}
.hero-image-label span:last-child { display: grid; gap: 2px; }
.hero-image-label small { color: #d7c6b7; font-size: 8px; letter-spacing: .17em; }
.hero-image-label strong { font-family: var(--font-display); font-size: 19px; font-weight: 400; }
.hero-orbit { position: absolute; z-index: -1; border: 1px solid rgba(217,119,54,.2); border-radius: 50%; pointer-events: none; }
.orbit-one { width: 130px; height: 130px; right: -28px; top: 5%; }
.orbit-two { width: 80px; height: 80px; left: -35px; bottom: 10%; }
.hero-side-note { position: absolute; right: -28px; top: 35%; writing-mode: vertical-rl; color: #8f8175; font-size: 8px; letter-spacing: .22em; }
.hero-bottom-note { position: absolute; left: 0; bottom: 28px; display: flex; align-items: center; gap: 12px; color: #7d756e; font-size: 8px; letter-spacing: .16em; }
.hero-bottom-note span:first-child { color: var(--copper-light); }
.hero-note-line { width: 42px; height: 1px; background: var(--copper); }

/* TICKER */
.ticker { overflow: hidden; background: #17120f; border-block: 1px solid rgba(217,119,54,.15); }
.ticker-track { width: max-content; min-height: 54px; display: flex; align-items: center; gap: 28px; animation: ticker 32s linear infinite; }
.ticker-track span { color: #c6b8aa; font-size: 9px; letter-spacing: .19em; white-space: nowrap; }
.ticker-track b { color: var(--copper); font-size: 14px; font-weight: 400; }
@keyframes ticker { to { transform: translateX(-50%); } }

/* MENU */
.menu-section { padding-block: clamp(80px, 10vw, 140px); }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 42px; }
.section-heading h2, .story-copy h2, .experience-heading h2, .reservation-copy h2, .location-heading h2 {
  font-size: clamp(36px, 4.2vw, 59px); margin: 17px 0 0;
}
.section-heading > p { max-width: 340px; color: var(--muted); font-size: 12px; line-height: 1.9; margin: 0 0 5px; }
.menu-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
.category-list { display: flex; gap: 8px; flex-wrap: wrap; }
.category-button {
  border: 1px solid var(--line); border-radius: 40px;
  padding: 10px 15px; background: transparent; color: #aaa29a;
  font-size: 10px; cursor: pointer; transition: .2s;
}
.category-button:hover, .category-button.active { color: var(--copper-light); border-color: var(--line-copper); background: rgba(217,119,54,.07); }
.menu-search { min-width: 195px; display: flex; align-items: center; gap: 9px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 30px; }
.menu-search svg { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: var(--muted); stroke-width: 1.5; }
.menu-search input { min-width: 0; width: 100%; border: 0; outline: 0; color: var(--text); background: transparent; font-size: 10px; }
.menu-search input::placeholder { color: #77716a; }
.menu-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 18px; }
.menu-card {
  min-width: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.075);
  border-radius: 20px; background: linear-gradient(145deg, #191817, #111110);
  transition: transform .3s var(--ease), border-color .3s, box-shadow .3s;
}
.menu-card:hover { transform: translateY(-5px); border-color: rgba(217,119,54,.32); box-shadow: 0 18px 40px rgba(0,0,0,.24); }
.menu-card-image { position: relative; height: clamp(155px, 17vw, 230px); overflow: hidden; background: #211e1b; }
.menu-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
.menu-card:hover .menu-card-image img { transform: scale(1.055); }
.menu-tag { position: absolute; top: 12px; left: 12px; padding: 6px 9px; border-radius: 30px; background: rgba(10,10,10,.77); border: 1px solid rgba(255,255,255,.13); color: #e5c5a8; font-size: 8px; letter-spacing: .1em; }
.add-item {
  position: absolute; right: 12px; bottom: 12px; width: 39px; height: 39px;
  display: grid; place-items: center; border: 0; border-radius: 50%;
  color: #170e08; background: var(--copper-light); font-size: 24px;
  line-height: 1; cursor: pointer; box-shadow: 0 5px 20px #0005;
  transition: transform .2s, background .2s;
}
.add-item:hover { transform: rotate(90deg) scale(1.06); background: #f4ad76; }
.menu-card-body { padding: 18px 16px 16px; }
.menu-card-category { color: var(--copper-light); font-size: 8px; letter-spacing: .16em; text-transform: uppercase; }
.menu-card h3 { margin: 8px 0; font-family: var(--font-display); font-weight: 500; font-size: 20px; line-height: 1.25; }
.menu-card-description { min-height: 43px; color: var(--muted); font-size: 10px; line-height: 1.7; margin: 0 0 16px; }
.menu-card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 12px; border-top: 1px solid var(--line); }
.menu-price { font-size: 15px; color: var(--ivory); font-weight: 600; white-space: nowrap; }
.menu-price small { display: block; color: #827970; font-size: 8px; font-weight: 400; }
.menu-bottom { margin-top: 25px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.menu-bottom p { margin: 0; color: var(--muted); font-size: 10px; }
.text-link { display: inline-flex; align-items: center; gap: 15px; color: var(--copper-light); font-size: 11px; font-weight: 600; }
.text-link span { font-size: 17px; transition: transform .2s; }
.text-link:hover span { transform: translate(3px,-3px); }
.menu-empty { grid-column: 1/-1; padding: 50px 20px; border: 1px dashed var(--line); border-radius: 18px; color: var(--muted); text-align: center; }

/* STORY */
.story-section { background: linear-gradient(120deg, #131110, #0d0c0b 72%); border-block: 1px solid rgba(255,255,255,.045); }
.story-inner { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(45px, 9vw, 130px); align-items: center; padding-block: clamp(80px, 10vw, 140px); }
.story-copy > p { color: var(--muted); font-size: 12px; line-height: 2; max-width: 440px; margin: 23px 0 0; }
.story-copy > .text-link { margin-top: 25px; }
.story-stats { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; margin-top: 45px; padding-top: 25px; border-top: 1px solid var(--line); }
.story-stats > div { display: grid; gap: 7px; }
.story-stats strong { color: var(--copper-light); font-family: var(--font-display); font-size: 29px; font-weight: 400; }
.story-stats span { color: var(--muted); font-size: 9px; line-height: 1.7; }
.story-collage { position: relative; min-height: 470px; display: grid; grid-template-columns: 1.1fr .9fr; grid-template-rows: 1fr .82fr; gap: 14px; }
.story-photo { margin: 0; min-width: 0; min-height: 0; overflow: hidden; background: var(--surface-2); border: 1px solid rgba(217,119,54,.15); }
.story-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.story-photo:hover img { transform: scale(1.035); }
.story-photo-main { grid-row: 1/3; border-radius: 100px 20px 20px 20px; }
.story-photo-top { border-radius: 20px 50px 20px 20px; }
.story-photo-bottom { border-radius: 20px; }
.collage-stamp { position: absolute; left: 46%; top: 50%; transform: translate(-50%,-50%); width: 90px; height: 90px; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1px; background: #14110e; border: 1px solid var(--copper); box-shadow: 0 0 0 7px rgba(10,10,10,.65); }
.collage-stamp span { font-size: 7px; color: #b9a38f; letter-spacing: .15em; }
.collage-stamp strong { color: var(--copper-light); font-family: var(--font-display); font-size: 29px; font-weight: 400; line-height: 1.1; }

/* EXPERIENCE */
.experience-section { padding-block: clamp(80px, 10vw, 135px); }
.experience-heading { text-align: center; }
.experience-heading .eyebrow { justify-content: center; }
.experience-heading h2 { margin-bottom: 43px; }
.experience-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
.experience-card { position: relative; min-width: 0; padding: 29px 25px 30px; border: 1px solid var(--line); border-radius: 21px; background: linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.008)); transition: border-color .25s, transform .25s; }
.experience-card:hover { border-color: var(--line-copper); transform: translateY(-3px); }
.experience-number { position: absolute; top: 22px; right: 23px; color: #62574d; font-size: 9px; letter-spacing: .12em; }
.experience-icon { display: grid; place-items: center; width: 45px; height: 45px; border-radius: 15px; background: rgba(217,119,54,.09); color: var(--copper-light); font-size: 22px; }
.experience-card h3 { margin: 25px 0 9px; font-family: var(--font-display); font-size: 23px; font-weight: 400; }
.experience-card p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.9; }

/* RESERVATIONS */
.reservation-section { background: radial-gradient(ellipse at 15% 50%,rgba(217,119,54,.09),transparent 48%), #14110f; border-block: 1px solid rgba(217,119,54,.13); }
.reservation-inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 9vw, 125px); align-items: center; padding-block: clamp(75px, 9vw, 125px); }
.reservation-copy > p { max-width: 390px; margin-top: 25px; color: var(--muted); font-size: 12px; line-height: 2; }
.reservation-note { display: flex; align-items: flex-start; gap: 10px; max-width: 370px; margin-top: 25px; color: #b2a59a; font-size: 10px; line-height: 1.8; }
.reservation-note span { color: var(--copper-light); }
.reservation-form { min-width: 0; padding: clamp(22px, 3vw, 37px); border: 1px solid rgba(217,119,54,.21); border-radius: 25px; background: linear-gradient(145deg,#1a1714,#11100f); box-shadow: 0 24px 70px rgba(0,0,0,.2); }
.form-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
.form-step { color: #766b60; font-size: 9px; letter-spacing: .13em; }
.reservation-form h3 { margin: 13px 0 24px; font-family: var(--font-display); font-size: 25px; font-weight: 400; }
.form-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
.field { min-width: 0; display: grid; gap: 7px; margin-bottom: 16px; }
.field > span { color: #d6ccc1; font-size: 10px; }
.field > span small { color: #8f8377; }
.field input, .field select, .field textarea {
  width: 100%; min-width: 0; min-height: 46px;
  padding: 12px 13px; border: 1px solid rgba(255,255,255,.11);
  border-radius: 12px; background: #100f0e; color: var(--text);
  outline: none; font-size: 11px; transition: border-color .2s, box-shadow .2s;
}
.field textarea { min-height: 72px; resize: vertical; }
.field input::placeholder, .field textarea::placeholder { color: #756d65; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--copper); box-shadow: 0 0 0 3px rgba(217,119,54,.08); }
.field.invalid input, .field.invalid select, .field.invalid textarea { border-color: #db6d61; }
.field-error { display: none; color: #f08d80; font-size: 9px; }
.field.invalid .field-error { display: block; }
.form-privacy { margin: 13px 0 0; color: #84786d; font-size: 9px; line-height: 1.7; }
.form-feedback { margin: 8px 0 0; color: var(--copper-light); font-size: 10px; }

/* LOCATION */
.location-section { padding-block: clamp(80px, 10vw, 135px); }
.location-heading { margin-bottom: 38px; }
.location-card { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 25px; overflow: hidden; background: #121110; }
.location-info { padding: clamp(25px, 5vw, 55px); background: radial-gradient(ellipse at top left,rgba(217,119,54,.1),transparent 70%); border-right: 1px solid var(--line); }
.location-icon { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 28px; border-radius: 15px; border: 1px solid var(--line-copper); color: var(--copper-light); font-size: 25px; }
.location-info h3 { margin: 14px 0 8px; font-family: var(--font-display); font-size: 30px; font-weight: 400; }
.location-info p, .detail-item p { color: var(--muted); font-size: 11px; line-height: 1.9; }
.location-info .text-link { margin-top: 16px; }
.location-details { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 26px; padding: clamp(25px, 5vw, 55px); }
.detail-item { display: grid; gap: 5px; }
.detail-label { color: var(--copper-light); font-size: 8px; letter-spacing: .17em; }
.detail-item strong { font-size: 13px; font-weight: 600; }
.detail-item p { margin: 0; }
.location-details > .button { margin-top: 3px; }

/* FOOTER */
.site-footer { background: #080808; border-top: 1px solid var(--line); }
.footer-main { display: grid; grid-template-columns: 1.45fr .7fr .9fr 1fr; gap: 35px; padding-block: 58px 48px; }
.footer-brand > p { max-width: 235px; margin: 20px 0 0; color: var(--muted); font-size: 10px; line-height: 1.9; }
.footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
.footer-title { margin-bottom: 5px; color: var(--copper-light); font-size: 8px; font-weight: 600; letter-spacing: .18em; }
.footer-column > a, .footer-column > p { margin: 0; color: var(--muted); font-size: 10px; transition: color .2s; }
.footer-column > a:hover { color: var(--ivory); }
.footer-hours strong { font-size: 12px; font-weight: 600; }
.footer-hours .status-dot { margin-top: 7px; }
