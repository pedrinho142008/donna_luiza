:root {
  --paper: #f7f4ec;
  --paper-deep: #eee8d9;
  --ink: #203a35;
  --ink-soft: #53645d;
  --teal: #285c53;
  --teal-dark: #173f39;
  --orange: #cf7955;
  --orange-light: #e5a07b;
  --white: #fffefa;
  --line: rgba(32, 58, 53, .16);
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
  --page-width: 1240px;
  --gutter: clamp(22px, 6.7vw, 100px);
  --radius: 5px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
body.menu-open { overflow: hidden; }
img { display: block; width: 100%; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { color: inherit; }
::selection { background: var(--teal); color: var(--white); }

.announcement {
  min-height: 34px;
  padding: 7px var(--gutter);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  background: var(--teal-dark);
  color: rgba(255, 254, 250, .87);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  text-align: center;
}
.announcement-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #dfb080;
}
.announcement-separator { color: #a6b7aa; }

.site-header {
  min-height: 88px;
  padding: 13px var(--gutter);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  background: rgba(247, 244, 236, .96);
  border-bottom: 1px solid rgba(32, 58, 53, .08);
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(18px);
}
.brand {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 11px;
}
.brand img {
  width: 49px;
  height: 49px;
  object-fit: contain;
  border-radius: 50%;
}
.brand-copy { display: flex; flex-direction: column; line-height: 1.2; }
.brand-name {
  font-family: var(--serif);
  font-size: 25px;
  letter-spacing: -.045em;
}
.brand-subtitle {
  margin-top: 5px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .15em;
}
.brand-subtitle i { color: var(--orange); font-style: normal; padding: 0 3px; }

.main-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(16px, 2.1vw, 30px);
}
.main-nav > a {
  position: relative;
  padding: 8px 0;
  color: #465850;
  font-size: 11px;
  font-weight: 600;
  transition: color .2s ease;
}
.main-nav > a:not(.nav-mobile-reserve)::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 2px;
  height: 1px;
  width: 0;
  background: var(--orange);
  transition: width .25s ease;
}
.main-nav > a:hover { color: var(--orange); }
.main-nav > a:hover::after { width: 100%; }
.header-reserve {
  flex: 0 0 auto;
  min-height: 40px;
  padding: 0 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  background: var(--teal);
  color: var(--white);
  border-radius: 2px;
  font-size: 10px;
  font-weight: 700;
  transition: background .2s, transform .2s;
}
.header-reserve:hover { background: var(--orange); transform: translateY(-1px); }
.header-reserve span, .button span { font-size: 15px; line-height: 1; }
.menu-toggle, .nav-mobile-reserve { display: none; }

.hero {
  min-height: 610px;
  position: relative;
  padding: 58px var(--gutter) 66px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 75% 40%, rgba(220, 203, 165, .26), transparent 33%),
    var(--paper);
}
.hero::before {
  content: "";
  position: absolute;
  width: 460px;
  height: 460px;
  border: 1px solid rgba(40, 92, 83, .12);
  border-radius: 50%;
  top: 75px;
  right: -180px;
  pointer-events: none;
}
.hero-texture {
  position: absolute;
  left: -190px;
  bottom: -310px;
  width: 430px;
  height: 430px;
  border: 1px solid rgba(207, 121, 85, .2);
  border-radius: 50%;
  pointer-events: none;
}
.hero-layout {
  max-width: var(--page-width);
  min-height: 465px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: .94fr 1.06fr;
  align-items: center;
  gap: clamp(40px, 8vw, 108px);
  position: relative;
  z-index: 1;
}
.hero-copy { padding: 12px 0 8px; }
.eyebrow, .section-index {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .16em;
  line-height: 1.5;
}
.eyebrow { color: var(--teal); }
.eyebrow-line {
  width: 27px;
  height: 1px;
  background: var(--orange);
}
.hero h1, .essence h2, .menu-heading h2, .experience-copy h2,
.reservation-copy h2, .contact-main h2 {
  margin: 24px 0 0;
  font-family: var(--serif);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -.055em;
}
.hero h1 {
  font-size: clamp(54px, 6.2vw, 88px);
}
.hero h1 em, .essence h2 em, .menu-heading h2 em,
.experience-copy h2 em, .reservation-copy h2 em, .contact-main h2 em {
  color: var(--orange);
  font-weight: 400;
}
.hero-description {
  max-width: 410px;
  margin: 25px 0 0;
  color: var(--ink-soft);
  font-size: 13px;
  line-height: 1.9;
}
.hero-actions {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 30px;
}
.button {
  min-height: 47px;
  width: fit-content;
  max-width: 100%;
  padding: 0 19px;
  border: 1px solid transparent;
  border-radius: 2px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.4;
  cursor: pointer;
  transition: background .22s, color .22s, border-color .22s, transform .22s;
}
.button:hover { transform: translateY(-2px); }
.button-dark { background: var(--teal); color: var(--white); }
.button-dark:hover { background: var(--teal-dark); }
.button-light {
  color: var(--teal-dark);
  background: var(--paper);
}
.button-light:hover { background: white; }
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 700;
  border-bottom: 1px solid var(--line);
  padding: 9px 0;
}
.text-link span { color: var(--orange); font-size: 16px; }
.hero-meta {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 46px;
}
.meta-item { display: flex; align-items: center; gap: 10px; }
.meta-icon {
  display: grid;
  place-items: center;
  width: 33px;
  height: 33px;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--orange);
  font-size: 18px;
}
.meta-item > span:last-child { display: flex; flex-direction: column; line-height: 1.45; }
.meta-item strong { font-size: 10px; font-weight: 700; }
.meta-item small { margin-top: 3px; color: var(--ink-soft); font-size: 9px; }
.meta-divider { height: 30px; width: 1px; background: var(--line); }

.hero-visual {
  min-height: 460px;
  position: relative;
  padding: 0 27px 28px 0;
}
.hero-image-main {
  position: absolute;
  inset: 0 27px 28px 30px;
  overflow: hidden;
  border-radius: 48% 48% 3px 3px;
  background: #ded4bd;
}
.hero-image-main img {
  height: 100%;
  object-fit: cover;
  transition: transform 1s cubic-bezier(.2,.7,.2,1);
}
.hero-visual:hover .hero-image-main img { transform: scale(1.035); }
.hero-image-main::after {
  content: "";
  position: absolute;
  inset: 0;
  border: 1px solid rgba(255,255,255,.32);
  border-radius: inherit;
  pointer-events: none;
}
.hero-image-small {
  position: absolute;
  width: 34%;
  height: 34%;
  right: -4px;
  bottom: 0;
  z-index: 3;
  padding: 7px;
  background: var(--paper);
  border-radius: 50% 50% 3px 3px;
  overflow: hidden;
}
.hero-image-small img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
.hero-stamp {
  width: 121px;
  height: 121px;
  position: absolute;
  z-index: 4;
  top: 15%;
  left: -30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--white);
  background: var(--orange);
  border-radius: 50%;
  transform: rotate(-9deg);
  text-align: center;
  box-shadow: 0 10px 30px rgba(100, 64, 40, .12);
}
.stamp-top, .stamp-bottom { font-size: 7px; font-weight: 700; letter-spacing: .11em; }
.stamp-main { font-family: var(--serif); font-size: 22px; font-style: italic; line-height: 1.2; }
.stamp-bottom { margin-top: 5px; }
.hero-photo-caption {
  position: absolute;
  bottom: 0;
  left: 31px;
  font-size: 8px;
  letter-spacing: .15em;
  font-weight: 700;
}
.hero-decoration {
  position: absolute;
  top: -20px;
  right: -7px;
  color: var(--orange);
  font-size: 43px;
  line-height: 1;
}
.scroll-cue {
  position: absolute;
  left: var(--gutter);
  bottom: 23px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #79857b;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .15em;
}
.scroll-cue span { width: 24px; height: 1px; background: var(--orange); }

.marquee-band {
  min-height: 57px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--teal);
  color: #f4efe3;
}
.marquee-track {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  gap: 28px;
  padding: 15px 20px;
  white-space: nowrap;
}
.marquee-track span { font-size: 9px; letter-spacing: .17em; font-weight: 600; }
.marquee-track b { color: var(--orange-light); font-size: 17px; font-weight: 400; }

.section-pad { padding: 112px var(--gutter); }
.section-index { color: #6c7b70; }
.section-index span { color: var(--orange); }
.essence { max-width: calc(var(--page-width) + var(--gutter) * 2); margin: 0 auto; }
.essence-layout {
  margin-top: 25px;
  display: grid;
  grid-template-columns: 1fr .72fr;
  align-items: end;
  gap: 90px;
}
.essence-title { position: relative; }
.essence h2, .menu-heading h2, .reservation-copy h2, .contact-main h2 {
  font-size: clamp(42px, 5vw, 66px);
}
.organic-mark {
  position: absolute;
  bottom: -17px;
  right: 12%;
  font-size: 38px;
  color: var(--orange);
}
.essence-copy { max-width: 445px; padding-bottom: 7px; }
.essence-copy p { color: var(--ink-soft); font-size: 12px; line-height: 1.95; }
.essence-copy .lead {
  color: var(--ink);
  margin: 0 0 15px;
  font-family: var(--serif);
  font-size: 21px;
  line-height: 1.5;
}
.underlined-link {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  margin-top: 13px;
  padding-bottom: 7px;
  border-bottom: 1px solid var(--orange);
  font-size: 10px;
  font-weight: 700;
}
.underlined-link span { font-size: 15px; color: var(--orange); }
.essence-image-row {
  margin-top: 59px;
  display: grid;
  grid-template-columns: 1.28fr .72fr;
  gap: 24px;
  align-items: start;
}
.essence-image { margin: 0; min-width: 0; }
.essence-image img {
  width: 100%;
  height: 340px;
  object-fit: cover;
  background: var(--paper-deep);
}
.essence-image-narrow { margin-top: 72px; }
.essence-image-narrow img { height: 267px; }
.essence-image figcaption {
  display: flex;
  gap: 14px;
  padding-top: 12px;
  font-size: 8px;
  letter-spacing: .1em;
  color: var(--orange);
  font-weight: 700;
}
.essence-image figcaption span { color: var(--ink-soft); font-size: 9px; letter-spacing: .04em; }

.menu-section {
  background: #efeade;
  position: relative;
  overflow: hidden;
}
.menu-section::before {
  content: "D";
  position: absolute;
  right: -30px;
  top: -170px;
  font-family: var(--serif);
  font-size: 510px;
  line-height: 1;
  color: rgba(40, 92, 83, .035);
  pointer-events: none;
}
.menu-heading {
  max-width: var(--page-width);
  margin: 0 auto;
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
}
.menu-heading h2 { margin-top: 22px; }
.menu-heading-aside { max-width: 350px; padding-bottom: 5px; }
.menu-heading-aside p { margin: 0; color: var(--ink-soft); font-size: 12px; line-height: 1.9; }
.menu-heading-aside .underlined-link { margin-top: 13px; }
.menu-filters {
  max-width: var(--page-width);
  margin: 48px auto 26px;
  position: relative;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.filter-button {
  min-height: 36px;
  padding: 0 16px;
  border: 1px solid rgba(32, 58, 53, .22);
  border-radius: 30px;
  background: transparent;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: .2s ease;
}
.filter-button:hover, .filter-button.active {
  color: var(--white);
  background: var(--teal);
  border-color: var(--teal);
}
.menu-grid {
  max-width: var(--page-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 30px 18px;
  position: relative;
}
.menu-loading { grid-column: 1 / -1; color: var(--ink-soft); font-size: 13px; }
.dish-card { min-width: 0; display: flex; flex-direction: column; }
.dish-image {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 4.2;
  overflow: hidden;
  background: #dcd1ba;
}
.dish-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s cubic-bezier(.2,.7,.2,1);
}
.dish-card:hover .dish-image img { transform: scale(1.055); }
.dish-category {
  position: absolute;
  left: 11px;
  top: 11px;
  padding: 5px 9px;
  background: rgba(247, 244, 236, .94);
  color: var(--teal-dark);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
}
.dish-number {
  position: absolute;
  right: 11px;
  bottom: 11px;
  color: white;
  text-shadow: 0 1px 8px rgba(0,0,0,.4);
  font-family: var(--serif);
  font-size: 15px;
}
.dish-content { padding: 14px 1px 0; flex: 1; display: flex; flex-direction: column; }
.dish-content h3 {
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(17px, 1.6vw, 21px);
  line-height: 1.32;
  font-weight: 500;
  letter-spacing: -.025em;
}
.dish-content p {
  margin: 8px 0 15px;
  color: var(--ink-soft);
  font-size: 10px;
  line-height: 1.8;
}
.dish-cta {
  width: fit-content;
  margin-top: auto;
  padding: 7px 0 3px;
  display: inline-flex;
  gap: 12px;
  align-items: center;
  border-bottom: 1px solid rgba(207, 121, 85, .6);
  font-size: 9px;
  font-weight: 700;
}
.dish-cta span { color: var(--orange); font-size: 14px; }
.menu-footnote {
  max-width: var(--page-width);
  margin: 44px auto 0;
  padding-top: 18px;
  border-top: 1px solid var(--line);
  display: flex;
  gap: 12px;
  align-items: start;
}
.footnote-star { color: var(--orange); font-size: 19px; line-height: 1.2; }
.menu-footnote p { margin: 0; color: var(--ink-soft); font-size: 9px; line-height: 1.8; }

.experience-section {
  min-height: 550px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative;
  background: var(--teal-dark);
  color: var(--white);
  overflow: hidden;
}
.experience-picture { min-height: 550px; overflow: hidden; position: relative; }
.experience-picture::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(15, 34, 29, .45), transparent 50%);
}
.experience-picture img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.picture-label {
  position: absolute;
  left: var(--gutter);
  bottom: 28px;
  z-index: 1;
  color: white;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .15em;
}
.experience-copy {
  align-self: center;
  max-width: 600px;
  padding: 70px clamp(35px, 7vw, 100px);
  position: relative;
  z-index: 1;
}
.section-index-light { color: #c7d3c7; }
.experience-copy h2 {
  margin-top: 28px;
  font-size: clamp(39px, 4.4vw, 59px);
  letter-spacing: -.05em;
}
.experience-copy h2 em { color: #e6a281; }
.experience-copy > p {
  max-width: 400px;
  margin: 23px 0 27px;
  color: rgba(255, 254, 250, .74);
  font-size: 12px;
  line-height: 2;
}
.experience-signature {
  display: block;
  margin-top: 36px;
  color: rgba(255,255,255,.62);
  font-family: var(--serif);
  font-size: 20px;
  font-style: italic;
}
.experience-signature i { color: var(--orange-light); font-style: normal; }
.experience-decoration {
  position: absolute;
  right: 20px;
  bottom: -112px;
  color: rgba(255,255,255,.035);
  font-family: var(--serif);
  font-size: 300px;
  line-height: 1;
  pointer-events: none;
}

.reservation-section {
  max-width: calc(var(--page-width) + var(--gutter) * 2);
  margin: 0 auto;
}
.reservation-layout {
  margin-top: 27px;
  display: grid;
  grid-template-columns: .9fr 1fr;
  gap: clamp(45px, 9vw, 130px);
  align-items: start;
}
.reservation-copy h2 { margin-top: 20px; }
.reservation-copy > p {
  max-width: 390px;
  margin-top: 24px;
  color: var(--ink-soft);
  font-size: 12px;
  line-height: 1.95;
}
.reservation-aside {
  margin-top: 40px;
  padding-top: 19px;
  border-top: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 13px;
}
.reservation-aside-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--orange);
}
.reservation-aside > span:last-child { display: flex; flex-direction: column; }
.reservation-aside strong { font-size: 10px; }
.reservation-aside small { margin-top: 3px; color: var(--ink-soft); font-size: 9px; }
.reservation-form {
  padding: clamp(23px, 3.5vw, 42px);
  background: #eee8d9;
  border-top: 3px solid var(--teal);
}
.form-topline {
  margin-bottom: 23px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  color: var(--ink-soft);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .12em;
}
.reservation-form label {
  display: block;
  margin: 15px 0 7px;
  font-size: 10px;
  font-weight: 700;
}
.reservation-form input, .reservation-form select, .reservation-form textarea {
  width: 100%;
  min-width: 0;
  min-height: 43px;
  padding: 11px 12px;
  color: var(--ink);
  border: 1px solid rgba(32, 58, 53, .19);
  border-radius: 2px;
  background: rgba(255, 254, 250, .68);
  font-size: 11px;
  outline: none;
  transition: border-color .2s, background .2s;
}
.reservation-form textarea { resize: vertical; min-height: 66px; }
.reservation-form input:focus, .reservation-form select:focus, .reservation-form textarea:focus {
  border-color: var(--teal);
  background: var(--white);
}
.reservation-form input::placeholder, .reservation-form textarea::placeholder { color: #8b968d; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.form-field { min-width: 0; }
.optional-label { margin-left: 7px; color: #829085; font-size: 8px; letter-spacing: .08em; }
.form-submit { width: 100%; margin-top: 22px; }
.form-disclaimer { margin: 12px 0 0; color: #718075; font-size: 9px; line-height: 1.7; }

.contact-section {
  padding: 0 var(--gutter) 100px;
}
.contact-card {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: clamp(35px, 6vw, 75px);
  display: grid;
  grid-template-columns: .85fr 1fr;
  gap: 50px 100px;
  position: relative;
  overflow: hidden;
  background: #e9e4d7;
}
