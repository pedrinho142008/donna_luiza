/* =========================================================
   AJUSTES DE CORREÇÃO — MARCA, RESPONSIVIDADE E LOCALIZAÇÃO
   ========================================================= */

html {
  scroll-behavior: smooth;
  scroll-padding-top: 95px;
  max-width: 100%;
  overflow-x: clip;
}

body {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}

img, svg, video, iframe {
  max-width: 100%;
}

button, input, select, textarea {
  font: inherit;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.brand {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  text-decoration: none;
}

.brand-logo {
  display: block;
  width: clamp(145px, 17vw, 205px);
  height: auto;
  max-height: 66px;
  object-fit: contain;
  object-position: left center;
  flex: 0 1 auto;
}

.footer-brand .brand-logo {
  width: clamp(155px, 19vw, 220px);
  max-height: 76px;
}

/* Botões mais consistentes e confortáveis no toque */
.button,
button.button,
.text-link,
.location-map-open {
  min-height: 44px;
  box-sizing: border-box;
  transition:
    background-color .22s ease,
    color .22s ease,
    border-color .22s ease,
    transform .22s ease,
    box-shadow .22s ease;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  max-width: 100%;
  padding: 13px 21px;
  border-radius: 999px;
  text-align: center;
  line-height: 1.35;
  white-space: normal;
  cursor: pointer;
}

.button-copper {
  box-shadow: 0 8px 24px rgba(217, 119, 54, .13);
}

.button-copper:hover {
  box-shadow: 0 10px 28px rgba(217, 119, 54, .24);
  transform: translateY(-2px);
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid #e6a06b;
  outline-offset: 3px;
}

/* Evita colunas e conteúdo ultrapassando a tela */
section,
.section-shell,
.hero,
.hero-content,
.hero-visual,
.story-grid,
.menu-header,
.menu-toolbar,
.location-card,
.footer-main {
  min-width: 0;
  max-width: 100%;
}

.hero-image,
.story-photo img,
.menu-card-image img {
  display: block;
  width: 100%;
}

.location-card {
  overflow: hidden;
}

.location-map-preview {
  position: relative;
  width: 100%;
  min-width: 0;
  height: clamp(230px, 32vw, 390px);
  overflow: hidden;
  background: #171411;
  border: 1px solid rgba(217, 119, 54, .2);
  border-radius: 20px;
}

.location-map-preview iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  filter: saturate(.85) contrast(1.04);
}

.location-map-open {
  position: absolute;
  left: 14px;
  bottom: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 11px 16px;
  border: 1px solid rgba(255, 255, 255, .17);
  border-radius: 999px;
  background: rgba(12, 11, 10, .92);
  color: #f5f0e8;
  font-size: 12px;
  text-decoration: none;
  box-shadow: 0 5px 20px rgba(0, 0, 0, .25);
}

.location-map-open:hover {
  background: #d97736;
  color: #0a0a0a;
}

