:root {
  --deep: #123c3c;
  --deep-2: #194b49;
  --teal: #2a7774;
  --teal-light: #a8d7ce;
  --orange: #f28b38;
  --orange-dark: #d76e25;
  --sand: #f5efe3;
  --sand-2: #e9ddca;
  --cream: #fffdf8;
  --ink: #213b38;
  --muted: #667671;
  --line: rgba(24, 57, 53, .14);
  --serif: 'Playfair Display', Georgia, serif;
  --sans: 'DM Sans', Arial, sans-serif;
  --content: 1240px;
  --gutter: clamp(22px, 5.8vw, 84px);
  --ease: cubic-bezier(.22,.7,.25,1);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 98px; }
body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
body.menu-open { overflow: hidden; }
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid rgba(242,139,56,.68); outline-offset: 3px; }
::selection { background: var(--orange); color: #fff; }
.topline { min-height: 31px; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 5px 14px; background: var(--deep); color: rgba(255,255,255,.79); font-size: 9px; font-weight: 700; letter-spacing: .17em; text-align: center; }
.topline-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--orange); }
.topline-divider { color: var(--orange); }
.site-header { position: sticky; z-index: 50; top: 0; min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 12px var(--gutter); background: rgba(255,253,248,.96); border-bottom: 1px solid rgba(18,60,60,.08); backdrop-filter: blur(16px); transition: box-shadow .3s ease, min-height .3s ease; }
.site-header.scrolled { box-shadow: 0 10px 30px rgba(23,50,45,.08); min-height: 76px; }
.brand { display: inline-flex; align-items: center; gap: 9px; flex: 0 0 auto; }
.brand-mark { width: 49px; height: 49px; object-fit: contain; }
.brand-wording { display: flex; flex-direction: column; line-height: 1.15; }
.brand-name { color: var(--deep); font-family: var(--serif); font-weight: 600; font-size: 25px; letter-spacing: -.04em; white-space: nowrap; }
.brand-subtitle { margin-top: 5px; color: #7a8075; font-size: 8px; font-weight: 700; letter-spacing: .17em; white-space: nowrap; }
.brand-subtitle i { color: var(--orange); font-style: normal; margin: 0 3px; }
.main-nav { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 2.5vw, 34px); margin-left: auto; }
.main-nav > a { position: relative; color: #52635d; font-size: 12px; font-weight: 600; transition: color .2s ease; white-space: nowrap; }
.main-nav > a:not(.nav-mobile-cta)::after { position: absolute; left: 0; right: 100%; bottom: -8px; height: 1px; background: var(--orange); content: ''; transition: right .25s ease; }
.main-nav > a:hover { color: var(--deep); }
.main-nav > a:hover::after { right: 0; }
.nav-mobile-cta, .menu-toggle { display: none; }
.button { min-height: 49px; display: inline-flex; align-items: center; justify-content: center; gap: 20px; padding: 13px 20px; border: 1px solid transparent; border-radius: 3px; font-size: 11px; font-weight: 700; letter-spacing: .01em; line-height: 1.2; cursor: pointer; transition: transform .25s var(--ease), background .25s ease, box-shadow .25s ease, border-color .25s ease; }
.button:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(13,41,38,.12); }
.button-small { min-height: 43px; padding: 11px 16px; gap: 14px; }
.button-orange { background: var(--orange); color: #fff; }
.button-orange:hover { background: var(--orange-dark); }
.button-dark { background: var(--deep); color: #fff; }
.button-dark:hover { background: var(--teal); }
.button-arrow { font-size: 16px; font-weight: 400; line-height: 1; transition: transform .2s ease; }
.button:hover .button-arrow { transform: translate(2px,-2px); }
.hero { position: relative; min-height: min(690px, calc(100svh - 118px)); min-height: clamp(590px, 71vw, 760px); overflow: hidden; isolation: isolate; background: #173c3a; color: #fff; }
.hero-image { position: absolute; z-index: -3; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 54%; animation: hero-settle 1.35s var(--ease) both; }
.hero-shade { position: absolute; z-index: -2; inset: 0; background: linear-gradient(90deg, rgba(8,37,36,.86) 0%, rgba(8,37,36,.72) 34%, rgba(8,37,36,.32) 65%, rgba(8,37,36,.16) 100%), linear-gradient(0deg, rgba(8,37,36,.5), transparent 35%); }
.hero-inner { position: relative; width: min(100%, var(--content)); min-height: inherit; margin: auto; padding: clamp(70px, 9vw, 116px) var(--gutter) 100px; }
.hero-copy { max-width: 670px; }
.eyebrow { display: flex; align-items: center; gap: 11px; color: #8a9690; font-size: 9px; font-weight: 700; letter-spacing: .19em; line-height: 1.5; }
.eyebrow-light { color: rgba(255,255,255,.75); }
.eyebrow-line { width: 27px; height: 1px; background: var(--orange); flex: 0 0 auto; }
h1, h2, h3, p { margin-top: 0; }
.hero h1 { margin: 25px 0 20px; font-family: var(--serif); font-size: clamp(52px, 7.4vw, 94px); font-weight: 500; line-height: .99; letter-spacing: -.055em; }
.hero h1 em, .section-title em { color: var(--orange); font-weight: 400; }
.hero-copy > p { max-width: 455px; margin-bottom: 29px; color: rgba(255,255,255,.8); font-size: 14px; line-height: 1.85; }
.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 25px; }
.text-link { display: inline-flex; align-items: center; gap: 12px; padding-bottom: 5px; font-size: 11px; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.35); transition: color .2s ease, border-color .2s ease, gap .2s ease; }
.text-link span { font-size: 16px; font-weight: 400; }
.text-link:hover { gap: 17px; border-color: var(--orange); }
.text-link-light { color: rgba(255,255,255,.95); }
.text-link-dark { color: var(--deep); border-color: rgba(18,60,60,.25); }
.text-link-dark:hover { color: var(--orange-dark); }
.hero-location { position: absolute; left: var(--gutter); bottom: 44px; display: flex; align-items: center; gap: 12px; }
.location-pin { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.48); border-radius: 50%; color: var(--orange); font-size: 22px; }
.hero-location > span:last-child { display: flex; flex-direction: column; gap: 2px; }
.hero-location strong { font-size: 11px; font-weight: 600; }
.hero-location small { color: rgba(255,255,255,.65); font-size: 10px; }
.hero-note { position: absolute; right: var(--gutter); bottom: 90px; width: 238px; min-height: 226px; padding: 24px 23px 20px; background: rgba(245,239,227,.95); color: var(--deep); box-shadow: 0 18px 55px rgba(0,0,0,.15); backdrop-filter: blur(6px); }
.note-kicker { display: block; margin-bottom: 14px; color: var(--teal); font-size: 8px; font-weight: 700; letter-spacing: .17em; }
.hero-note p { max-width: 175px; margin-bottom: 18px; font-family: var(--serif); font-size: 20px; line-height: 1.32; }
.note-decoration { display: flex; align-items: center; justify-content: space-between; color: rgba(18,60,60,.35); font-family: var(--serif); font-size: 18px; }
.note-decoration span { color: var(--orange); font-size: 20px; }
.hero-scroll { position: absolute; right: var(--gutter); bottom: 29px; display: flex; align-items: center; gap: 11px; color: rgba(255,255,255,.67); font-size: 8px; font-weight: 700; letter-spacing: .16em; }
.scroll-line { width: 27px; height: 1px; background: var(--orange); }
.hero-index { position: absolute; top: 50%; right: 20px; display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,.65); font-size: 8px; letter-spacing: .1em; writing-mode: vertical-rl; transform: translateY(-50%); }
.hero-index > span:first-child { color: var(--orange); }
.hero-index-line { width: 1px; height: 56px; background: rgba(255,255,255,.3); }
.essence-strip { display: grid; grid-template-columns: repeat(4, 1fr); padding: 30px var(--gutter); background: var(--sand); border-bottom: 1px solid rgba(30,67,60,.07); }
.essence-item { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 5px 16px; border-right: 1px solid rgba(25,72,65,.13); }
.essence-item:first-child { padding-left: 0; }
.essence-item:last-child { border-right: 0; padding-right: 0; }
.essence-icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid rgba(32,111,103,.2); border-radius: 50%; color: var(--teal); font-family: var(--serif); font-size: 23px; }
.essence-item h2 { margin: 0 0 2px; color: var(--deep); font-size: 11px; font-weight: 700; }
.essence-item p { margin: 0; color: #738079; font-size: 9px; line-height: 1.5; }
.section-pad { padding: clamp(78px, 10vw, 138px) var(--gutter); }
.about { display: grid; grid-template-columns: minmax(0, .98fr) minmax(0, 1fr); align-items: center; gap: clamp(45px, 9vw, 128px); width: min(100%, 1440px); margin: auto; }
.about-visual { position: relative; max-width: 550px; padding: 0 45px 42px 0; }
.about-photo-frame { position: relative; height: clamp(400px, 48vw, 575px); overflow: hidden; background: #c3c7b5; }
.about-photo-frame::after { position: absolute; inset: 14px; border: 1px solid rgba(255,255,255,.65); content: ''; pointer-events: none; }
.about-photo-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
.about-visual:hover .about-photo-frame img { transform: scale(1.035); }
.about-seal { position: absolute; right: 0; bottom: 10px; width: 142px; height: 142px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: var(--orange); color: white; box-shadow: 0 12px 26px rgba(160,83,28,.17); transform: rotate(7deg); }
.about-seal span { font-size: 10px; letter-spacing: .03em; }
.about-seal strong { margin: 2px 0; font-family: var(--serif); font-size: 31px; font-weight: 500; line-height: 1.1; }
.about-seal i { margin-top: 4px; font-size: 13px; font-style: normal; }
.about-caption { position: absolute; left: 0; bottom: 0; display: flex; align-items: center; gap: 10px; color: #859089; font-size: 8px; font-weight: 700; letter-spacing: .15em; }
.caption-line { display: inline-block; width: 28px; height: 1px; background: var(--orange); }
.about-copy { max-width: 510px; padding: 16px 0; }
.section-title { margin: 20px 0 23px; color: var(--deep); font-family: var(--serif); font-size: clamp(39px, 4.6vw, 59px); font-weight: 500; line-height: 1.09; letter-spacing: -.05em; }
.section-title em { color: var(--teal); }
.about-copy .lead { margin-bottom: 14px; color: #394d47; font-family: var(--serif); font-size: 19px; line-height: 1.5; }
.about-copy > p:not(.lead) { margin-bottom: 14px; color: #69756f; font-size: 12px; line-height: 1.95; }
.about-copy .text-link { margin-top: 13px; }
.signature { display: flex; align-items: center; gap: 13px; margin-top: 37px; }
.signature-rule { width: 42px; height: 1px; background: var(--orange); }
.signature > span:last-child { display: flex; flex-direction: column; }
.signature strong { color: var(--deep); font-family: var(--serif); font-size: 22px; font-weight: 600; line-height: 1.2; }
.signature small { margin-top: 4px; color: #859088; font-size: 7px; font-weight: 700; letter-spacing: .17em; }
.menu-section { background: var(--sand); overflow: hidden; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; max-width: var(--content); margin: 0 auto 36px; }
.section-heading .section-title { margin-bottom: 0; }
.section-heading > p { max-width: 320px; margin: 0 0 4px; color: #6c7971; font-size: 12px; line-height: 1.9; }
.menu-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: var(--content); margin: 0 auto 24px; }
.filter-list { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.filter-button { padding: 9px 13px; border: 1px solid rgba(18,60,60,.15); border-radius: 2px; background: transparent; color: #61716a; font-size: 10px; font-weight: 600; cursor: pointer; transition: all .2s ease; }
.filter-button:hover { border-color: var(--teal); color: var(--deep); }
.filter-button.active { border-color: var(--deep); background: var(--deep); color: white; }
.carousel-controls { display: flex; flex: 0 0 auto; gap: 7px; }
.round-control { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid rgba(18,60,60,.24); border-radius: 50%; background: transparent; color: var(--deep); font-size: 18px; cursor: pointer; transition: all .2s ease; }
.round-control:hover { background: var(--deep); color: #fff; border-color: var(--deep); }
.menu-viewport { width: min(100%, var(--content)); margin: 0 auto; overflow: hidden; }
.menu-grid { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3); gap: 24px; align-items: stretch; overflow-x: auto; padding: 0 1px 15px; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: rgba(18,60,60,.28) transparent; }
.dish-card { min-width: 0; scroll-snap-align: start; background: var(--cream); border: 1px solid rgba(25,68,61,.08); transition: transform .3s var(--ease), box-shadow .3s ease; animation: card-enter .45s var(--ease) both; }
.dish-card:hover { transform: translateY(-5px); box-shadow: 0 16px 35px rgba(21,57,50,.1); }
.dish-photo { position: relative; height: clamp(185px, 22vw, 260px); overflow: hidden; background: #d6d0bd; }
.dish-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s var(--ease); }
.dish-card:hover .dish-photo img { transform: scale(1.055); }
.dish-category { position: absolute; left: 13px; top: 13px; padding: 6px 8px; background: rgba(255,253,248,.94); color: var(--deep); font-size: 8px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.dish-content { display: flex; flex-direction: column; min-height: 178px; padding: 18px 18px 17px; }
.dish-title { margin: 0 0 8px; color: var(--deep); font-family: var(--serif); font-size: 21px; font-weight: 500; line-height: 1.23; }
.dish-description { margin: 0 0 15px; color: #78827b; font-size: 10px; line-height: 1.7; }
.dish-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 10px; border-top: 1px solid rgba(18,60,60,.1); }
.dish-price { color: #77817a; font-size: 9px; font-weight: 600; }
.dish-consult { display: inline-flex; align-items: center; gap: 7px; color: var(--teal); font-size: 10px; font-weight: 700; white-space: nowrap; }
.dish-consult span { font-size: 15px; transition: transform .2s ease; }
.dish-consult:hover span { transform: translate(2px,-2px); }
.menu-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: var(--content); margin: 22px auto 0; }
.menu-note { display: inline-flex; align-items: center; gap: 8px; color: #78837c; font-size: 10px; }
.tiny-spark { color: var(--orange); font-size: 17px; }
.quote-band { position: relative; display: grid; min-height: 330px; place-items: center; overflow: hidden; padding: 60px var(--gutter); background: var(--deep); color: white; isolation: isolate; }
.quote-band::before { position: absolute; z-index: -1; inset: 0; background: radial-gradient(ellipse at center, rgba(53,119,107,.24), transparent 60%); content: ''; }
.quote-orbit { position: absolute; z-index: -1; width: 350px; height: 350px; border: 1px solid rgba(193,222,207,.11); border-radius: 50%; }
.quote-orbit-one { left: -110px; bottom: -240px; }
.quote-orbit-two { right: -70px; top: -240px; width: 430px; height: 430px; }
.quote-content { max-width: 730px; text-align: center; }
.quote-mark { display: block; height: 46px; color: var(--orange); font-family: var(--serif); font-size: 75px; line-height: 1; }
.quote-content p { margin: 12px 0 22px; font-family: var(--serif); font-size: clamp(26px, 3.8vw, 43px); font-weight: 400; line-height: 1.35; letter-spacing: -.025em; }
.quote-credit { color: #a8c3b9; font-size: 8px; font-weight: 700; letter-spacing: .2em; }
.quote-side-label { position: absolute; right: 20px; top: 50%; color: rgba(255,255,255,.35); font-size: 8px; font-weight: 700; letter-spacing: .16em; writing-mode: vertical-rl; transform: translateY(-50%); }
.experience { max-width: 1440px; margin: auto; }
.experience-heading { text-align: center; max-width: 590px; margin: 0 auto 47px; }
.experience-heading .eyebrow { justify-content: center; }
.experience-heading .section-title { margin-bottom: 15px; }
.experience-heading > p { color: #758078; font-size: 12px; line-height: 1.9; }
.experience-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: 24px; }
.experience-card { position: relative; min-height: 430px; overflow: hidden; background: var(--deep); color: #fff; }
.experience-card-large { min-height: 490px; }
.experience-card > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .75s var(--ease); }
.experience-card:hover > img { transform: scale(1.04); }
.experience-card-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(8,35,33,.84), rgba(8,35,33,.05) 73%); }
.experience-card-copy { position: absolute; left: clamp(22px, 3vw, 43px); right: 22px; bottom: 33px; }
.experience-card-copy > span { display: block; margin-bottom: 12px; color: #f8b579; font-size: 8px; font-weight: 700; letter-spacing: .18em; }
.experience-card-copy h3 { margin-bottom: 10px; font-family: var(--serif); font-size: clamp(29px, 3vw, 42px); font-weight: 400; line-height: 1.12; letter-spacing: -.035em; }
.experience-card-copy p { margin: 0; color: rgba(255,255,255,.75); font-size: 11px; }
.experience-card-small .experience-card-copy h3 { font-size: clamp(28px, 2.5vw, 36px); }
.reservation { display: grid; grid-template-columns: .88fr 1.12fr; background: var(--deep); color: white; }
.reservation-image-wrap { position: relative; min-height: 690px; overflow: hidden; background: #264c45; }
.reservation-image-wrap > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.reservation-image-tint { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(9,38,35,.55), rgba(9,38,35,.13)); }
.reservation-stamp { position: absolute; left: 50%; top: 50%; width: 190px; height: 190px; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.75); outline: 1px solid rgba(255,255,255,.5); outline-offset: 7px; border-radius: 50%; color: white; transform: translate(-50%,-50%) rotate(-7deg); text-align: center; }
.reservation-stamp span { font-size: 8px; font-weight: 700; letter-spacing: .16em; }
.reservation-stamp strong { margin: 3px 0; font-family: var(--serif); font-size: 37px; font-weight: 400; }
.reservation-stamp i { color: var(--orange); font-style: normal; }
.reservation-content { align-self: center; width: min(100%, 690px); padding: clamp(52px, 7vw, 93px) clamp(25px, 7vw, 95px); }
.section-title-light { margin-bottom: 15px; color: white; font-size: clamp(40px, 4.3vw, 56px); }
.section-title-light em { color: #f4a45e; }
.reservation-content > p:not(.reservation-hint) { max-width: 420px; margin-bottom: 28px; color: rgba(255,255,255,.65); font-size: 12px; line-height: 1.9; }
.reservation-form { display: grid; grid-template-columns: 1fr 1fr; gap: 17px 16px; }
.field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
.field > span { color: rgba(255,255,255,.85); font-size: 10px; font-weight: 600; }
.field > span small { color: rgba(255,255,255,.45); font-size: 9px; font-weight: 400; }
.field input, .field select { width: 100%; height: 46px; min-width: 0; padding: 0 12px; border: 1px solid rgba(255,255,255,.2); border-radius: 2px; background: rgba(255,255,255,.055); color: white; font-size: 11px; outline: none; }
.field input::placeholder { color: rgba(255,255,255,.38); }
.field input:focus, .field select:focus { border-color: var(--orange); }
.field select { color-scheme: dark; }
.field-full { grid-column: 1 / -1; }
.reservation-submit { grid-column: 1 / -1; width: 100%; margin-top: 3px; }
.reservation-hint { display: flex; gap: 8px; margin: 15px 0 0; color: rgba(255,255,255,.48); font-size: 9px; line-height: 1.6; }
.reservation-hint span { color: var(--orange); }
.visit-section { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(45px, 9vw, 125px); max-width: 1440px; margin: auto; }
.visit-main { align-self: center; }
.visit-main .section-title { margin-bottom: 17px; }
.visit-main > p { max-width: 345px; margin-bottom: 27px; color: #748078; font-size: 12px; line-height: 1.9; }
.visit-details { padding: 5px 0; border-top: 1px solid var(--line); }
.visit-detail { display: grid; grid-template-columns: 43px 1fr; gap: 15px; padding: 22px 0; border-bottom: 1px solid var(--line); }
.detail-icon { width: 37px; height: 37px; display: grid; place-items: center; border: 1px solid rgba(40,119,111,.23); border-radius: 50%; color: var(--teal); font-size: 22px; }
.detail-label { color: #8a958e; font-size: 8px; font-weight: 700; letter-spacing: .18em; }
.visit-detail h3 { margin: 4px 0 3px; color: var(--deep); font-family: var(--serif); font-size: 21px; font-weight: 500; }
.visit-detail p { margin: 0 0 4px; color: #758078; font-size: 11px; }
.visit-detail a { color: var(--teal); font-size: 10px; font-weight: 700; }
.visit-detail a:hover { color: var(--orange-dark); }
.visit-detail small { display: block; color: #97a098; font-size: 9px; }
.newsletter-band { display: flex; align-items: center; justify-content: space-between; gap: 36px; padding: 31px var(--gutter); background: #e9dfce; }
.newsletter-copy { display: flex; align-items: center; gap: 15px; }
.newsletter-star { color: var(--orange-dark); font-size: 33px; }
.newsletter-copy h2 { margin: 0 0 3px; color: var(--deep); font-family: var(--serif); font-size: 22px; font-weight: 500; }
