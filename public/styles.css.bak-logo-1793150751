.cart-drawer.open { transform: translateX(0); visibility: visible; }
.drawer-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
.drawer-header h2 { margin: 7px 0 0; font-family: var(--font-display); font-size: 28px; font-weight: 400; }
.drawer-header h2 span { color: var(--copper-light); font-family: var(--font-body); font-size: 12px; }
.drawer-close { font-size: 25px; font-weight: 300; }
.cart-items { min-height: 0; flex: 1; overflow: auto; padding-block: 8px; }
.cart-line { display: grid; grid-template-columns: 72px minmax(0,1fr) auto; gap: 12px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); }
.cart-line img { width: 72px; height: 78px; border-radius: 12px; object-fit: cover; background: var(--surface-2); }
.cart-line h3 { margin: 0 0 5px; font-family: var(--font-display); font-size: 16px; font-weight: 400; line-height: 1.25; }
.cart-line-price { color: var(--copper-light); font-size: 11px; }
.quantity-control { display: flex; align-items: center; gap: 10px; margin-top: 9px; }
.quantity-control button { width: 25px; height: 25px; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer; }
.quantity-control span { font-size: 10px; }
.remove-item { align-self: start; border: 0; background: transparent; color: #8b8076; cursor: pointer; font-size: 18px; }
.cart-empty { display: none; flex: 1; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.cart-empty.visible { display: flex; }
.empty-bag { display: grid; place-items: center; width: 65px; height: 65px; border: 1px solid var(--line-copper); border-radius: 50%; color: var(--copper-light); font-size: 28px; }
.cart-empty h3 { margin: 19px 0 5px; font-family: var(--font-display); font-size: 23px; font-weight: 400; }
.cart-empty p { color: var(--muted); font-size: 11px; }
.cart-footer { padding-top: 20px; border-top: 1px solid var(--line); }
.cart-footer.hidden { display: none; }
.cart-total { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.cart-total span { color: var(--muted); font-size: 12px; }
