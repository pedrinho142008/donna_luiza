.cart-footer > p { margin: 8px 0 16px; color: var(--muted); font-size: 9px; line-height: 1.7; }
.clear-cart { display: block; margin: 12px auto 0; border: 0; background: transparent; color: #a39a91; font-size: 10px; text-decoration: underline; cursor: pointer; }
.toast { position: fixed; z-index: 80; bottom: 25px; left: 50%; max-width: calc(100% - 32px); padding: 12px 18px; transform: translate(-50%,20px); opacity: 0; visibility: hidden; border: 1px solid var(--line-copper); border-radius: 14px; background: #1b1713; color: var(--ivory); box-shadow: 0 12px 35px #0008; font-size: 11px; text-align: center; transition: .25s; }
.toast.visible { transform: translate(-50%,0); opacity: 1; visibility: visible; }
.floating-whatsapp { position: fixed; z-index: 25; right: 20px; bottom: 20px; width: 51px; height: 51px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.23); border-radius: 50%; background: #237b4b; color: white; box-shadow: 0 7px 24px #0008; transition: transform .2s; }
.floating-whatsapp:hover { transform: translateY(-3px); }
.floating-whatsapp svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

